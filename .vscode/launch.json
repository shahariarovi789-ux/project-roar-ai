{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Run Evaluation Benchmark (run_eval.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluation/run_eval.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "📊 Generate Evaluation Plots (plot_results.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/evaluation/plot_results.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "🧪 Run Pytest Suite (test_qa_full.py)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_qa_full.py",
        "-v"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "🌐 Start Project ROAR Web Server (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}
