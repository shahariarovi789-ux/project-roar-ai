{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Full Evaluation Benchmark",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python -m evaluation.run_eval",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Generate Evaluation Charts",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python -m evaluation.plot_results",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Run All Pytest Tests",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/pytest tests/ -v",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Project ROAR Server",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/python main.py",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "problemMatcher": []
    }
  ]
}
